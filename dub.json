{
    "name": "dservice",
    "license": "MIT",
	"authors": [ "rocex" ],
	"copyright": "Copyright © 2026, rocex",
	"description": "Windows 后台程序服务守护工具。",
	"mainSourceFile": "source/app.d",
    "targetPath": ".dub",
	"configurations": [
		{
			"name": "application",
			"targetType": "executable",
			"sourceFiles": ["source/app.d"],
			"sourcePaths": ["source"]
		},
		{
			"name": "unittest",
			"preRunCommands-windows-x86_mscoff": ["dub build --config=application --build=release --compiler=\"$DC\" --arch=x86"],
			"preRunCommands-windows-x86_64": ["dub build --config=application --build=release --compiler=\"$DC\" --arch=x86_64"],
			"targetType": "executable",
			"sourceFiles": ["source/app.d"],
			"targetName": "dservice-unittest",
			"mainSourceFile": "source/app.d",
			"sourcePaths": ["source", "source-test"]
		}
	]
}
